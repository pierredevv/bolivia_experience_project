generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  password       String?
  photoUrl       String?  @map("photo_url")
  country        String?
  language       String   @default("es")
  role           String   @default("usuario")
  isActive       Boolean  @default(true) @map("is_active")
  isPremium      Boolean  @default(false) @map("is_premium")
  businessName   String?  @map("business_name")
  businessPhone  String?  @map("business_phone")
  approvalStatus String   @default("none") @map("approval_status")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  points        Int      @default(0)

  places              Place[]
  reviews             Review[]          @relation("ReviewAuthor")
  reviewsModerated    Review[]          @relation("ReviewModerator")
  favorites           Favorite[]
  replies             ReviewReply[]
  searchHistory       SearchHistory[]
  notifications       Notification[]
  deviceTokens        DeviceToken[]
  refreshTokens       RefreshToken[]
  referral            Referral?
  referredUses        ReferralUse[]
  reservations        Reservation[]
  tours               Tour[]
  tickets             Ticket[]
  payments            Payment[]
  products            Product[]
  settlements         Settlement[]
  chatConversations   ChatConversation[]
  trips               Trip[]
  travelerPhotos      TravelerPhoto[]
  travelerPhotoLikes  TravelerPhotoLike[]
  productReviews      ProductReview[]

  @@map("users")
}

model Category {
  id            String   @id @default(cuid())
  name          String
  nameEn        String   @map("name_en")
  icon          String
  slug          String   @unique
  description   String?
  descriptionEn String?  @map("description_en")
  displayOrder  Int      @default(0) @map("display_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  places Place[]

  @@map("categories")
}

model Place {
  id            String   @id @default(cuid())
  name          String
  description   String?
  descriptionEn String?  @map("description_en")
  address       String
  phone         String?
  website       String?
  instagram     String?
  facebook      String?
  tiktok        String?
  latitude      Float
  longitude     Float
  ratingAvg     Float    @default(0) @map("rating_avg")
  ratingCount   Int      @default(0) @map("rating_count")
  categoryId    String   @map("category_id")
  ownerId       String?  @map("owner_id")
  city          String   @default("santa-cruz")
  isEcoFriendly   Boolean   @default(false) @map("is_eco_friendly")
  isUrban         Boolean   @default(true) @map("is_urban")
  isFeatured      Boolean   @default(false) @map("is_featured")
  isActive        Boolean   @default(true) @map("is_active")
  priceLevel      Int?      @map("price_level")
  priceUpdatedAt  DateTime? @map("price_updated_at")
  priceProposedBy String?   @map("price_proposed_by")
  specialFeature  String?   @map("special_feature")
  cuisineType     String?   @map("cuisine_type")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  category   Category      @relation(fields: [categoryId], references: [id])
  owner      User?         @relation(fields: [ownerId], references: [id])
  photos     PlacePhoto[]
  hours      PlaceHour[]
  reviews    Review[]
  favorites  Favorite[]
  promotions Promotion[]
  reservations Reservation[]
  tours      Tour[]
  products   Product[]

  @@index([categoryId])
  @@index([ownerId])
  @@map("places")
}

model PlacePhoto {
  id           String   @id @default(cuid())
  placeId      String   @map("place_id")
  url          String
  altText      String?  @map("alt_text")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId])
  @@map("place_photos")
}

model PlaceHour {
  id        String   @id @default(cuid())
  placeId   String   @map("place_id")
  dayOfWeek Int      @map("day_of_week")
  openTime  String?  @map("open_time")
  closeTime String?  @map("close_time")
  isClosed  Boolean  @default(false) @map("is_closed")

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, dayOfWeek])
  @@index([placeId])
  @@map("place_hours")
}

model Review {
  id             String       @id @default(cuid())
  userId         String       @map("user_id")
  placeId        String       @map("place_id")
  rating         Int
  comment        String?
  photos         String       @default("[]")
  visitDate      String?      @map("visit_date")
  status         String       @default("PUBLISHED")
  moderatedAt    DateTime?    @map("moderated_at")
  moderatedById  String?      @map("moderated_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  user         User          @relation("ReviewAuthor", fields: [userId], references: [id], onDelete: Cascade)
  place        Place         @relation(fields: [placeId], references: [id], onDelete: Cascade)
  moderatedBy  User?         @relation("ReviewModerator", fields: [moderatedById], references: [id])
  replies      ReviewReply[]

  @@unique([userId, placeId])
  @@index([placeId])
  @@index([userId])
  @@index([status])
  @@map("reviews")
}

model ReviewReply {
  id        String   @id @default(cuid())
  reviewId  String   @map("review_id")
  userId    String   @map("user_id")
  comment   String
  createdAt DateTime @default(now()) @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([userId])
  @@map("review_replies")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  placeId   String   @map("place_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([userId])
  @@index([placeId])
  @@map("favorites")
}

model Event {
  id            String   @id @default(cuid())
  name          String
  nameEn        String?  @map("name_en")
  description   String?
  descriptionEn String?  @map("description_en")
  dateStart     DateTime @map("date_start")
  dateEnd       DateTime? @map("date_end")
  location      String?
  latitude      Float?
  longitude     Float?
  photoUrl      String?  @map("photo_url")
  category      String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tickets Ticket[]

  @@index([dateStart])
  @@map("events")
}

model Promotion {
  id                 String   @id @default(cuid())
  placeId            String   @map("place_id")
  title              String
  titleEn            String?  @map("title_en")
  description        String?
  descriptionEn      String?  @map("description_en")
  photoUrl           String?  @map("photo_url")
  discountPercentage Int?     @map("discount_percentage")
  startDate          DateTime @map("start_date")
  endDate            DateTime @map("end_date")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId])
  @@map("promotions")
}

model SearchHistory {
  id           String   @id @default(cuid())
  userId       String?  @map("user_id")
  query        String
  filters      String?
  resultsCount Int?     @map("results_count")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("search_history")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  body      String
  type      String
  data      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  platform  String   @default("flutter")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model Referral {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  code           String   @unique
  referralCount  Int      @default(0) @map("referral_count")
  rewardsEarned  Int      @default(0) @map("rewards_earned")
  createdAt      DateTime @default(now()) @map("created_at")

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  referredVia ReferralUse[] @relation("ReferredVia")

  @@index([code])
  @@map("referrals")
}

model ReferralUse {
  id             String   @id @default(cuid())
  referrerId     String   @map("referrer_id")
  referredUserId String   @unique @map("referred_user_id")
  code           String
  createdAt      DateTime @default(now()) @map("created_at")

  referrer     Referral @relation("ReferredVia", fields: [referrerId], references: [userId], onDelete: Cascade)
  referredUser User     @relation(fields: [referredUserId], references: [id], onDelete: Cascade)

  @@map("referral_uses")
}

model Reservation {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  // Transición: fase 1 usa productId; el app legacy envía placeId (se resuelve a producto)
  productId     String?   @map("product_id")
  placeId       String?   @map("place_id")
  date          DateTime
  time          String
  partySize     Int       @map("party_size")
  // Ciclo de vida: pendiente | confirmada | rechazada | cancelada | completada | expirada | no_show
  status        String    @default("pending")
  // Modalidad capturada al crear: instantanea | solicitud
  modalidad     String    @default("instantanea")
  // Solicitud manual: plazo de respuesta
  responseDeadline DateTime? @map("response_deadline")
  respondedAt   DateTime? @map("responded_at")
  confirmedAt   DateTime? @map("confirmed_at")
  cancelledAt   DateTime? @map("cancelled_at")
  completedAt   DateTime? @map("completed_at")
  cancelReason  String?   @map("cancel_reason")
  // Monto acordado al confirmar (sin comisión)
  totalAmount   Float?    @map("total_amount")
  notes         String?
  contactPhone  String?   @map("contact_phone")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  place   Place?  @relation(fields: [placeId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@index([userId])
  @@index([productId])
  @@index([placeId])
  @@index([status])
  @@index([date])
  @@index([productId, date, time, status])
  @@map("reservations")
}

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  description String
  discount    Int
  maxUses     Int      @map("max_uses")
  usedCount   Int      @default(0) @map("used_count")
  validFrom   DateTime @map("valid_from")
  validUntil  DateTime @map("valid_until")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([code])
  @@map("coupons")
}

model Product {
  id                  String   @id @default(cuid())
  socioId             String   @map("socio_id")
  placeId             String?  @map("place_id")
  // tipo: hospedaje | transporte | actividad | guia | mesa | paquete | experiencia
  type                String   @default("actividad")
  name                String
  description         String?
  descriptionEn       String?  @map("description_en")
  price               Float    @default(0)
  currency            String   @default("BOB")
  // Cupo/inventario por fecha-hora para modalidad instantanea (null = sin límite)
  capacity            Int?
  // ninguna | solicitud | instantanea
  modalidadReserva    String   @default("ninguna") @map("modalidad_reserva")
  // tipo_turismo: urbano | rural | ambos
  tourismType         String?  @map("tourism_type")
  // rango_presupuesto: mochilero | medio | premium
  budgetRange         String?  @map("budget_range")
  // verificado | pendiente | desactualizado
  verificationStatus  String   @default("pendiente") @map("verification_status")
  priceUpdatedAt      DateTime? @map("price_updated_at")
  // Atributos específicos por tipo (JSON) - MVP
  attributesJson      String?  @map("attributes_json")
  // ── Hoteles: campos de la tarjeta (gestionados por el socio) ──
  caracteristicas    String  ? @map("caracteristicas")
  comodidadesJson    String   @default("[]") @map("comodidades_json")
  // tipo de propiedad: hotel | bnb | inn
  tipoPropiedad      String?  @map("tipo_propiedad")
  estrellas          Int?     @map("estrellas")
  // texto_precio: variante fija del set controlado
  textoPrecio        String?  @map("texto_precio")
  // ── Hoteles: gestión admin (cashback / premiado) ──
  cashbackActivo     Boolean  @default(false) @map("cashback_activo")
  cashbackPorcentaje Int?     @map("cashback_porcentaje")
  premiado           Boolean  @default(false) @map("premiado")
  // ── Hoteles: ofertas / deals (mock determinista) ──
  tieneOferta        Boolean  @default(false) @map("tiene_oferta")
  reembolsable       Boolean  @default(false) @map("reembolsable")
  pagoDiferido       Boolean  @default(false) @map("pago_diferido")
  // Experiencias: categoría (ej. "Tours de Noche") y precio por adulto
  experienceCategory  String?  @map("experience_category")
  pricePerAdult       Float?   @map("price_per_adult")
  priceVarByGroup     Boolean  @default(false) @map("price_var_by_group")
  photoUrl            String?  @map("photo_url")
  // Detalle de experiencia (completado por el socio)
  duration            String?  @map("duration")
  minAge              Int?     @map("min_age")
  maxAge              Int?     @map("max_age")
  maxGroup            Int?     @map("max_group")
  guideLanguage       String?  @map("guide_language")
  mobileTicket        Boolean  @default(false) @map("mobile_ticket")
  advanceDays         Int?     @default(23) @map("advance_days")
  // Políticas como array JSON, ej. ["Garantía de precio más bajo", "Cancelación gratuita"]
  policiesJson        String   @default("[]") @map("policies_json")
  ratingAvg           Float    @default(0) @map("rating_avg")
  ratingCount         Int      @default(0) @map("rating_count")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  socio         User          @relation(fields: [socioId], references: [id], onDelete: Cascade)
  place         Place?        @relation(fields: [placeId], references: [id], onDelete: SetNull)
  policy        CancellationPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  policyId      String?       @map("policy_id")
  reservations  Reservation[]
  productReviews ProductReview[]
  slots         ProductSlot[]

  @@index([socioId])
  @@index([placeId])
  @@index([type])
  @@index([modalidadReserva])
  @@map("products")
}

model ProductReview {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  userId    String   @map("user_id")
  rating    Int
  comment   String?
  status    String   @default("PUBLISHED")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@index([status])
  @@map("product_reviews")
}

// Slots de disponibilidad de una experiencia ("Reserva tu lugar")
model ProductSlot {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  date      String   @map("date") // Fecha de la sesión, ej. "2026-08-08"
  time      String   @map("time") // Hora de inicio, ej. "09:00"
  capacity  Int      @default(10) @map("capacity")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([date])
  @@map("product_slots")
}

model CancellationPolicy {
  id        String   @id @default(cuid())
  name      String
  description String?
  // Plantilla de reembolso: [{hastaHoras: 48, reembolso: 100}, {hastaHoras: 24, reembolso: 50}, {reembolso: 0}]
  rulesJson String   @default("[]") @map("rules_json")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("cancellation_policies")
}

model PlatformConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_configs")
}

model Settlement {
  id               String    @id @default(cuid())
  paymentId        String    @unique @map("payment_id")
  socioId          String    @map("socio_id")
  grossAmount      Float     @map("gross_amount")
  commissionAmount Float     @map("commission_amount")
  netAmount        Float     @map("net_amount")
  // pending | released
  status           String    @default("pending")
  releasedAt       DateTime? @map("released_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  socio   User    @relation(fields: [socioId], references: [id], onDelete: Cascade)

  @@index([socioId])
  @@index([status])
  @@map("settlements")
}

model Tour {
  id          String   @id @default(cuid())
  name        String
  description String
  descriptionEn String? @map("description_en")
  price       Float
  currency    String   @default("BOB")
  duration    String
  maxGroup    Int      @map("max_group")
  providerId  String   @map("provider_id")
  placeId     String?  @map("place_id")
  isActive    Boolean  @default(true) @map("is_active")
  ratingAvg   Float?   @map("rating_avg")
  ratingCount Int      @default(0) @map("rating_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  provider User   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  place    Place? @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([providerId])
  @@index([placeId])
  @@map("tours")
}

model Ticket {
  id           String   @id @default(cuid())
  eventId      String   @map("event_id")
  userId       String?  @map("user_id")
  ticketType   String   @map("ticket_type")
  price        Float
  currency     String   @default("BOB")
  status       String   @default("available")
  qrCode       String?  @unique @map("qr_code")
  purchasedAt  DateTime? @map("purchased_at")
  usedAt       DateTime? @map("used_at")
  createdAt    DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([userId])
  @@index([qrCode])
  @@map("tickets")
}

model Payment {
  id            String    @id
  userId        String    @map("user_id")
  reservationId String?   @map("reservation_id")
  amount        Float
  currency      String    @default("BOB")
  description   String
  type          String
  referenceId   String    @map("reference_id")
  // Escrow: retenido hasta que se presta el servicio
  subtotal        Float   @default(0)
  commissionRate  Float   @default(0) @map("commission_rate")
  commissionAmount Float  @default(0) @map("commission_amount")
  // Ciclo de vida: pending | held | released | refunded | cancelled
  status        String    @default("pending")
  transactionId String?   @map("transaction_id")
  qrData        String?   @map("qr_data")
  paidAt        DateTime? @map("paid_at")
  heldAt        DateTime? @map("held_at")
  releasedAt    DateTime? @map("released_at")
  refundedAt    DateTime? @map("refunded_at")
  refundAmount  Float?    @map("refund_amount")
  createdAt     DateTime  @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  settlement  Settlement?

  @@index([userId])
  @@index([status])
  @@index([referenceId])
  @@index([reservationId])
  @@map("payments")
}

model ChatConversation {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId])
  @@map("chat_conversations")
}

model ChatMessage {
  id              String   @id @default(cuid())
  conversationId  String   @map("conversation_id")
  role            String
  content         String
  createdAt       DateTime @default(now()) @map("created_at")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("chat_messages")
}

model Trip {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  name        String
  description String?
  destination String?
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  budgetType  String?  @map("budget_type")
  budgetMin   Float?   @map("budget_min")
  budgetMax   Float?   @map("budget_max")
  tourismType String?  @map("tourism_type")
  groupType   String?  @map("group_type")
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  days TripDay[]

  @@index([userId])
  @@map("trips")
}

model TripDay {
  id          String   @id @default(cuid())
  tripId      String   @map("trip_id")
  dayNumber   Int      @map("day_number")
  date        DateTime
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  trip  Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items TripItem[]

  @@index([tripId])
  @@map("trip_days")
}

model TripItem {
  id          String   @id @default(cuid())
  tripDayId   String   @map("trip_day_id")
  placeId     String?  @map("place_id")
  title       String
  description String?
  timeSlot    String?  @map("time_slot")
  orderIndex  Int      @default(0) @map("order_index")
  createdAt   DateTime @default(now()) @map("created_at")

  tripDay TripDay @relation(fields: [tripDayId], references: [id], onDelete: Cascade)

  @@index([tripDayId])
  @@map("trip_items")
}

model TravelerPhoto {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  imageUrl    String   @map("image_url")
  title       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes TravelerPhotoLike[]

  @@index([userId])
  @@index([createdAt])
  @@map("traveler_photos")
}

model TravelerPhotoLike {
  id        String   @id @default(cuid())
  photoId   String   @map("photo_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  photo TravelerPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([photoId, userId])
  @@index([photoId])
  @@index([userId])
  @@map("traveler_photo_likes")
}
