generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  password       String?
  photoUrl       String?  @map("photo_url")
  country        String?
  language       String   @default("es")
  role           String   @default("usuario")
  isActive       Boolean  @default(true) @map("is_active")
  businessName   String?  @map("business_name")
  businessPhone  String?  @map("business_phone")
  approvalStatus String   @default("none") @map("approval_status")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  places        Place[]
  reviews       Review[]
  favorites     Favorite[]
  replies       ReviewReply[]
  searchHistory SearchHistory[]
  notifications Notification[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Category {
  id            String   @id @default(cuid())
  name          String
  nameEn        String   @map("name_en")
  icon          String
  slug          String   @unique
  description   String?
  descriptionEn String?  @map("description_en")
  displayOrder  Int      @default(0) @map("display_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  places Place[]

  @@map("categories")
}

model Place {
  id            String   @id @default(cuid())
  name          String
  description   String?
  descriptionEn String?  @map("description_en")
  address       String
  phone         String?
  website       String?
  instagram     String?
  facebook      String?
  tiktok        String?
  latitude      Float
  longitude     Float
  ratingAvg     Float    @default(0) @map("rating_avg")
  ratingCount   Int      @default(0) @map("rating_count")
  categoryId    String   @map("category_id")
  ownerId       String?  @map("owner_id")
  isFeatured    Boolean  @default(false) @map("is_featured")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  category   Category    @relation(fields: [categoryId], references: [id])
  owner      User?       @relation(fields: [ownerId], references: [id])
  photos     PlacePhoto[]
  hours      PlaceHour[]
  reviews    Review[]
  favorites  Favorite[]
  promotions Promotion[]

  @@index([categoryId])
  @@index([ownerId])
  @@map("places")
}

model PlacePhoto {
  id           String   @id @default(cuid())
  placeId      String   @map("place_id")
  url          String
  altText      String?  @map("alt_text")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId])
  @@map("place_photos")
}

model PlaceHour {
  id        String   @id @default(cuid())
  placeId   String   @map("place_id")
  dayOfWeek Int      @map("day_of_week")
  openTime  String?  @map("open_time")
  closeTime String?  @map("close_time")
  isClosed  Boolean  @default(false) @map("is_closed")

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, dayOfWeek])
  @@index([placeId])
  @@map("place_hours")
}

model Review {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  placeId    String   @map("place_id")
  rating     Int
  comment    String?
  photos     String   @default("[]")
  visitDate  String?  @map("visit_date")
  isApproved Boolean  @default(false) @map("is_approved")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  place   Place         @relation(fields: [placeId], references: [id], onDelete: Cascade)
  replies ReviewReply[]

  @@unique([userId, placeId])
  @@index([placeId])
  @@index([userId])
  @@map("reviews")
}

model ReviewReply {
  id        String   @id @default(cuid())
  reviewId  String   @map("review_id")
  userId    String   @map("user_id")
  comment   String
  createdAt DateTime @default(now()) @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([userId])
  @@map("review_replies")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  placeId   String   @map("place_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([userId])
  @@index([placeId])
  @@map("favorites")
}

model Event {
  id            String   @id @default(cuid())
  name          String
  nameEn        String?  @map("name_en")
  description   String?
  descriptionEn String?  @map("description_en")
  dateStart     DateTime @map("date_start")
  dateEnd       DateTime? @map("date_end")
  location      String?
  latitude      Float?
  longitude     Float?
  photoUrl      String?  @map("photo_url")
  category      String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([dateStart])
  @@map("events")
}

model Promotion {
  id                 String   @id @default(cuid())
  placeId            String   @map("place_id")
  title              String
  titleEn            String?  @map("title_en")
  description        String?
  descriptionEn      String?  @map("description_en")
  photoUrl           String?  @map("photo_url")
  discountPercentage Int?     @map("discount_percentage")
  startDate          DateTime @map("start_date")
  endDate            DateTime @map("end_date")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId])
  @@map("promotions")
}

model SearchHistory {
  id           String   @id @default(cuid())
  userId       String?  @map("user_id")
  query        String
  filters      String?
  resultsCount Int?     @map("results_count")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("search_history")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  body      String
  type      String
  data      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model Referral {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  code           String   @unique
  referralCount  Int      @default(0) @map("referral_count")
  rewardsEarned  Int      @default(0) @map("rewards_earned")
  createdAt      DateTime @default(now()) @map("created_at")

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  referredVia ReferralUse[] @relation("ReferredVia")

  @@index([code])
  @@map("referrals")
}

model ReferralUse {
  id             String   @id @default(cuid())
  referrerId     String   @map("referrer_id")
  referredUserId String   @unique @map("referred_user_id")
  code           String
  createdAt      DateTime @default(now()) @map("created_at")

  referrer     Referral @relation("ReferredVia", fields: [referrerId], references: [userId], onDelete: Cascade)
  referredUser User     @relation(fields: [referredUserId], references: [id], onDelete: Cascade)

  @@map("referral_uses")
}

model Reservation {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  placeId      String   @map("place_id")
  date         DateTime
  time         String
  partySize    Int      @map("party_size")
  status       String   @default("pending") // pending, confirmed, cancelled, completed
  notes        String?
  contactPhone String?  @map("contact_phone")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([placeId])
  @@index([date])
  @@map("reservations")
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  description String
  discount    Int       // percentage
  maxUses     Int       @map("max_uses")
  usedCount   Int       @default(0) @map("used_count")
  validFrom   DateTime  @map("valid_from")
  validUntil  DateTime  @map("valid_until")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([code])
  @@map("coupons")
}

model Tour {
  id          String   @id @default(cuid())
  name        String
  description String
  descriptionEn String? @map("description_en")
  price       Float
  currency    String   @default("BOB")
  duration    String   // e.g., "3 hours"
  maxGroup    Int      @map("max_group")
  providerId  String   @map("provider_id")
  placeId     String?  @map("place_id")
  isActive    Boolean  @default(true) @map("is_active")
  ratingAvg   Float?   @map("rating_avg")
  ratingCount Int      @default(0) @map("rating_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  provider User   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  place    Place? @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([providerId])
  @@index([placeId])
  @@map("tours")
}

model Ticket {
  id           String   @id @default(cuid())
  eventId      String   @map("event_id")
  userId       String?  @map("user_id")
  ticketType   String   @map("ticket_type") // general, vip, etc.
  price        Float
  currency     String   @default("BOB")
  status       String   @default("available") // available, sold, reserved, used
  qrCode       String?  @unique @map("qr_code")
  purchasedAt  DateTime? @map("purchased_at")
  usedAt       DateTime? @map("used_at")
  createdAt    DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([userId])
  @@index([qrCode])
  @@map("tickets")
}

model Payment {
  id            String    @id
  userId        String    @map("user_id")
  amount        Float
  currency      String    @default("BOB")
  description   String
  type          String    // reservation, ticket, tour, coupon
  referenceId   String    @map("reference_id")
  status        String    @default("pending") // pending, completed, failed, refunded
  transactionId String?   @map("transaction_id")
  qrData        String?   @map("qr_data")
  paidAt        DateTime? @map("paid_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([referenceId])
  @@map("payments")
}
