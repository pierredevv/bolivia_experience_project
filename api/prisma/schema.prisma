generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  password       String?
  photoUrl       String?  @map("photo_url")
  country        String?
  language       String   @default("es")
  role           String   @default("usuario")
  isActive       Boolean  @default(true) @map("is_active")
  businessName   String?  @map("business_name")
  businessPhone  String?  @map("business_phone")
  approvalStatus String   @default("none") @map("approval_status")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  places        Place[]
  reviews       Review[]
  favorites     Favorite[]
  replies       ReviewReply[]
  searchHistory SearchHistory[]
  notifications Notification[]

  @@map("users")
}

model Category {
  id            String   @id @default(cuid())
  name          String
  nameEn        String   @map("name_en")
  icon          String
  slug          String   @unique
  description   String?
  descriptionEn String?  @map("description_en")
  displayOrder  Int      @default(0) @map("display_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  places Place[]

  @@map("categories")
}

model Place {
  id            String   @id @default(cuid())
  name          String
  description   String?
  descriptionEn String?  @map("description_en")
  address       String
  phone         String?
  website       String?
  instagram     String?
  facebook      String?
  tiktok        String?
  latitude      Float
  longitude     Float
  ratingAvg     Float    @default(0) @map("rating_avg")
  ratingCount   Int      @default(0) @map("rating_count")
  categoryId    String   @map("category_id")
  ownerId       String?  @map("owner_id")
  isFeatured    Boolean  @default(false) @map("is_featured")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  category   Category    @relation(fields: [categoryId], references: [id])
  owner      User?       @relation(fields: [ownerId], references: [id])
  photos     PlacePhoto[]
  hours      PlaceHour[]
  reviews    Review[]
  favorites  Favorite[]
  promotions Promotion[]

  @@index([categoryId])
  @@index([ownerId])
  @@map("places")
}

model PlacePhoto {
  id           String   @id @default(cuid())
  placeId      String   @map("place_id")
  url          String
  altText      String?  @map("alt_text")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId])
  @@map("place_photos")
}

model PlaceHour {
  id        String   @id @default(cuid())
  placeId   String   @map("place_id")
  dayOfWeek Int      @map("day_of_week")
  openTime  String?  @map("open_time")
  closeTime String?  @map("close_time")
  isClosed  Boolean  @default(false) @map("is_closed")

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, dayOfWeek])
  @@index([placeId])
  @@map("place_hours")
}

model Review {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  placeId    String   @map("place_id")
  rating     Int
  comment    String?
  photos     String   @default("[]")
  visitDate  String?  @map("visit_date")
  isApproved Boolean  @default(false) @map("is_approved")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  place   Place         @relation(fields: [placeId], references: [id], onDelete: Cascade)
  replies ReviewReply[]

  @@unique([userId, placeId])
  @@index([placeId])
  @@index([userId])
  @@map("reviews")
}

model ReviewReply {
  id        String   @id @default(cuid())
  reviewId  String   @map("review_id")
  userId    String   @map("user_id")
  comment   String
  createdAt DateTime @default(now()) @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([userId])
  @@map("review_replies")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  placeId   String   @map("place_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([userId])
  @@index([placeId])
  @@map("favorites")
}

model Event {
  id            String   @id @default(cuid())
  name          String
  nameEn        String?  @map("name_en")
  description   String?
  descriptionEn String?  @map("description_en")
  dateStart     DateTime @map("date_start")
  dateEnd       DateTime? @map("date_end")
  location      String?
  latitude      Float?
  longitude     Float?
  photoUrl      String?  @map("photo_url")
  category      String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([dateStart])
  @@map("events")
}

model Promotion {
  id                 String   @id @default(cuid())
  placeId            String   @map("place_id")
  title              String
  titleEn            String?  @map("title_en")
  description        String?
  descriptionEn      String?  @map("description_en")
  photoUrl           String?  @map("photo_url")
  discountPercentage Int?     @map("discount_percentage")
  startDate          DateTime @map("start_date")
  endDate            DateTime @map("end_date")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId])
  @@map("promotions")
}

model SearchHistory {
  id           String   @id @default(cuid())
  userId       String?  @map("user_id")
  query        String
  filters      String?
  resultsCount Int?     @map("results_count")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("search_history")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  body      String
  type      String
  data      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}
