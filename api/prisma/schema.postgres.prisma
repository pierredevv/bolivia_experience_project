generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique @db.VarChar(255)
  name      String   @db.VarChar(255)
  password  String?  @db.VarChar(255)
  photoUrl  String?  @map("photo_url") @db.Text
  country   String?  @db.VarChar(100)
  language  String   @default("es") @db.VarChar(5)
  role      String   @default("usuario") @db.VarChar(20)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  places        Place[]
  reviews       Review[]
  favorites     Favorite[]
  replies       ReviewReply[]
  searchHistory SearchHistory[]
  notifications Notification[]

  @@map("users")
}

model Category {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String   @db.VarChar(100)
  nameEn        String   @map("name_en") @db.VarChar(100)
  icon          String   @db.VarChar(50)
  slug          String   @unique @db.VarChar(100)
  description   String?  @db.Text
  descriptionEn String?  @map("description_en") @db.Text
  displayOrder  Int      @default(0) @map("display_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  places Place[]

  @@map("categories")
}

model Place {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String   @db.VarChar(255)
  description   String?  @db.Text
  descriptionEn String?  @map("description_en") @db.Text
  address       String   @db.VarChar(500)
  phone         String?  @db.VarChar(50)
  website       String?  @db.VarChar(255)
  instagram     String?  @db.VarChar(255)
  facebook      String?  @db.VarChar(255)
  tiktok        String?  @db.VarChar(255)
  latitude      Decimal  @db.Decimal(10, 8)
  longitude     Decimal  @db.Decimal(11, 8)
  ratingAvg     Decimal  @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount   Int      @default(0) @map("rating_count")
  categoryId    String   @map("category_id") @db.Uuid
  ownerId       String?  @map("owner_id") @db.Uuid
  isFeatured    Boolean  @default(false) @map("is_featured")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  category   Category    @relation(fields: [categoryId], references: [id])
  owner      User?       @relation(fields: [ownerId], references: [id])
  photos     PlacePhoto[]
  hours      PlaceHour[]
  reviews    Review[]
  favorites  Favorite[]
  promotions Promotion[]

  @@index([categoryId])
  @@index([ownerId])
  @@map("places")
}

model PlacePhoto {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  placeId      String   @map("place_id") @db.Uuid
  url          String   @db.Text
  altText      String?  @map("alt_text") @db.VarChar(255)
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId])
  @@map("place_photos")
}

model PlaceHour {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  placeId   String  @map("place_id") @db.Uuid
  dayOfWeek Int     @map("day_of_week")
  openTime  DateTime? @map("open_time") @db.Time
  closeTime DateTime? @map("close_time") @db.Time
  isClosed  Boolean @default(false) @map("is_closed")

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, dayOfWeek])
  @@index([placeId])
  @@map("place_hours")
}

model Review {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  placeId    String    @map("place_id") @db.Uuid
  rating     Int
  comment    String?   @db.Text
  photos     String[]
  visitDate  DateTime? @map("visit_date") @db.Date
  isApproved Boolean   @default(false) @map("is_approved")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  place   Place         @relation(fields: [placeId], references: [id], onDelete: Cascade)
  replies ReviewReply[]

  @@unique([userId, placeId])
  @@index([placeId])
  @@index([userId])
  @@map("reviews")
}

model ReviewReply {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewId  String   @map("review_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  comment   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([userId])
  @@map("review_replies")
}

model Favorite {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  placeId   String   @map("place_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([userId])
  @@index([placeId])
  @@map("favorites")
}

model Event {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String    @db.VarChar(255)
  nameEn        String?   @map("name_en") @db.VarChar(255)
  description   String?   @db.Text
  descriptionEn String?   @map("description_en") @db.Text
  dateStart     DateTime  @map("date_start") @db.Timestamptz()
  dateEnd       DateTime? @map("date_end") @db.Timestamptz()
  location      String?   @db.VarChar(500)
  latitude      Decimal?  @db.Decimal(10, 8)
  longitude     Decimal?  @db.Decimal(11, 8)
  photoUrl      String?   @map("photo_url") @db.Text
  category      String?   @db.VarChar(100)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([dateStart])
  @@map("events")
}

model Promotion {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  placeId            String   @map("place_id") @db.Uuid
  title              String   @db.VarChar(255)
  titleEn            String?  @map("title_en") @db.VarChar(255)
  description        String?  @db.Text
  descriptionEn      String?  @map("description_en") @db.Text
  photoUrl           String?  @map("photo_url") @db.Text
  discountPercentage Int?     @map("discount_percentage")
  startDate          DateTime @map("start_date") @db.Timestamptz()
  endDate            DateTime @map("end_date") @db.Timestamptz()
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId])
  @@map("promotions")
}

model SearchHistory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  query        String   @db.VarChar(255)
  filters      Json?
  resultsCount Int?     @map("results_count")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("search_history")
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String   @db.VarChar(255)
  body      String   @db.Text
  type      String   @db.VarChar(50)
  data      Json?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}
