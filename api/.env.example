# ============================================
# Database Configuration
# ============================================
# Toggle between SQLite (no Docker) and PostgreSQL (Docker required)
#
# For SQLite (recommended for quick local dev):
#   DB_PROVIDER=sqlite
#   DATABASE_URL="file:./dev.db"
#
# For PostgreSQL (Docker required):
#   DB_PROVIDER=postgresql
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5433/bolivia_experience"
#
# Quick switch: node setup-db.js sqlite --seed
# ============================================

DB_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"

# Firebase (optional - lazy initialized)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="your-private-key"
FIREBASE_CLIENT_EMAIL=your-client-email@your-project.iam.gserviceaccount.com

# APIs (optional)
GOOGLE_MAPS_API_KEY=your-google-maps-key
OPENWEATHER_API_KEY=your-openweather-key

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# App
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Stripe (Fase B - pago con tarjeta/wallet internacional, solo USD)
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER
STRIPE_PUBLISHABLE_KEY=pk_test_PLACEHOLDER
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER
STRIPE_CURRENCY=usd

# PayPal (Fase C - pago con PayPal, solo USD)
# Mode: sandbox | live
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID_PLACEHOLDER
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET_PLACEHOLDER
PAYPAL_WEBHOOK_ID=YOUR_PAYPAL_WEBHOOK_ID_PLACEHOLDER

# QR del banco local (Fase C/D - pago por QR, solo BOB)
# UNAVAILABLE hasta que el banco/socio otorgue acceso a su API (endpoint, claves, webhook).
QR_BANCO_BASE_URL=YOUR_QR_BANK_API_URL_PLACEHOLDER
QR_BANCO_CLIENT_ID=YOUR_QR_BANK_CLIENT_ID_PLACEHOLDER
QR_BANCO_CLIENT_SECRET=YOUR_QR_BANK_CLIENT_SECRET_PLACEHOLDER
QR_BANCO_MERCHANT_ID=YOUR_QR_BANK_MERCHANT_ID_PLACEHOLDER
QR_BANCO_WEBHOOK_SECRET=YOUR_QR_BANK_WEBHOOK_SECRET_PLACEHOLDER

# Tipo de cambio BOB->USD usado por los proveedores USD (stripe/paypal).
# Es administrable de forma dinámica vía admin (config/exchange-rate-usd-bob).
# Valor por defecto si no se define. Ej: 6.96
EXCHANGE_RATE_USD_BOB=6.96

